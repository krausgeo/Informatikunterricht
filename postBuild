#!/bin/bash
set -e
# Install OpenJDK 17 and graphviz
apt-get update -qq
apt-get install -y -qq openjdk-17-jdk-headless graphviz
# Install IJava kernel for Binder (so Java kernel is available)
wget -q https://github.com/SpencerPark/IJava/releases/download/v1.3.0/ijava-1.3.0.zip
unzip -q ijava-1.3.0.zip -d ijava
python3 ijava/install.py --sys-prefix
